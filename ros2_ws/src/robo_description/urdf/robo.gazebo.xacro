<?xml version="1.0"?>
<!--
  Gazebo Fortress (gz-sim) only content for Companion ROBO, per docs/docs_ros2_architecture.md
  Section 5. Included from robo.urdf.xacro only when use_sim:=true, so the exact same
  base xacro loads on the real robot with none of this present and the TF tree stays
  identical between sim and hardware (Section 4/6).
-->
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!-- Differential drive: left pair (fl, rl) / right pair (fr, rr), per the
       skid-steer wheel layout defined in robo.urdf.xacro. Odometry publication
       and odom TF are disabled (odom_publish_frequency=0) per Section 5/6 of
       the architecture doc: cuVSLAM owns map->odom->base_link, not this plugin,
       so it must not publish a competing TF. -->
  <gazebo>
    <plugin filename="gz-sim-diff-drive-system" name="gz::sim::systems::DiffDrive">
      <left_joint>wheel_fl_joint</left_joint>
      <left_joint>wheel_rl_joint</left_joint>
      <right_joint>wheel_fr_joint</right_joint>
      <right_joint>wheel_rr_joint</right_joint>
      <wheel_separation>${track_width}</wheel_separation>
      <wheel_radius>${wheel_radius}</wheel_radius>
      <odom_publish_frequency>0</odom_publish_frequency>
      <topic>/cmd_vel</topic>
      <frame_id>odom</frame_id>
      <child_frame_id>base_link</child_frame_id>
    </plugin>

    <plugin filename="gz-sim-joint-state-publisher-system" name="gz::sim::systems::JointStatePublisher">
      <joint_name>wheel_fl_joint</joint_name>
      <joint_name>wheel_fr_joint</joint_name>
      <joint_name>wheel_rl_joint</joint_name>
      <joint_name>wheel_rr_joint</joint_name>
    </plugin>
  </gazebo>

  <!-- Stereo cameras: attached to the X-forward camera_*_link (not the
       *_optical link) since gz-sim's default camera sensor look direction is
       the parent frame's local +X, matching our URDF convention. optical_frame_id
       overrides the published frame_id to the REP-103 optical frame defined in
       robo.urdf.xacro, so downstream consumers (rectify, VSLAM, stereo_image_proc)
       see the same frame_id in sim as they will from argus_stereo_node on real
       hardware. No <topic> override: left as the gz-sim default scoped topic
       name (.../link/<link>/sensor/<name>/image|camera_info) so it lines up
       with robo_sim/config/bridge.yaml's gz_topic_name entries.

       Both sensors share camera_update_rate so gz-sim's deterministic,
       sim-time-stepped Sensors system ticks them on the same simulation step;
       there is no additional "sync" plugin needed for that in sim. -->
  <gazebo reference="camera_left_link">
    <sensor name="left_camera" type="camera">
      <always_on>true</always_on>
      <update_rate>${camera_update_rate}</update_rate>
      <visualize>true</visualize>
      <optical_frame_id>camera_left_optical</optical_frame_id>
      <camera>
        <horizontal_fov>${camera_hfov}</horizontal_fov>
        <image>
          <width>${camera_width_px}</width>
          <height>${camera_height_px}</height>
          <format>R8G8B8</format>
        </image>
        <clip>
          <near>0.05</near>
          <far>30.0</far>
        </clip>
      </camera>
    </sensor>
  </gazebo>

  <gazebo reference="camera_right_link">
    <sensor name="right_camera" type="camera">
      <always_on>true</always_on>
      <update_rate>${camera_update_rate}</update_rate>
      <visualize>true</visualize>
      <optical_frame_id>camera_right_optical</optical_frame_id>
      <camera>
        <horizontal_fov>${camera_hfov}</horizontal_fov>
        <image>
          <width>${camera_width_px}</width>
          <height>${camera_height_px}</height>
          <format>R8G8B8</format>
        </image>
        <clip>
          <near>0.05</near>
          <far>30.0</far>
        </clip>
      </camera>
    </sensor>
  </gazebo>

</robot>
