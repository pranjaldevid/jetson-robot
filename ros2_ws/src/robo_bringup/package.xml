<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>robo_bringup</name>
  <version>0.0.1</version>
  <description>Top-level launch files for Companion ROBO: sim.launch.py, real.launch.py, perception.launch.py, slam.launch.py, nav.launch.py.</description>
  <maintainer email="pranjaltikhe05@gmail.com">pranjal</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_python</buildtool_depend>

  <exec_depend>robo_description</exec_depend>
  <exec_depend>robo_sim</exec_depend>
  <exec_depend>robo_drivers</exec_depend>
  <exec_depend>robo_perception</exec_depend>
  <exec_depend>robo_navigation</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>ros_gz_bridge</exec_depend>
  <exec_depend>twist_mux</exec_depend>
  <!-- isaac_ros_image_proc / isaac_ros_stereo_image_proc (Phase 2 rectify +
       disparity/point cloud) are intentionally NOT declared here: they are
       Isaac ROS packages installed via NVIDIA's own apt/Docker channel on
       JetPack 6, not resolvable via rosdep on a non-Jetson dev machine, and
       common.launch.py gates them behind enable_isaac_ros so their absence
       does not break colcon build or sim.launch.py elsewhere. -->

  <test_depend>ament_copyright</test_depend>
  <test_depend>ament_flake8</test_depend>
  <test_depend>ament_pep257</test_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
