<?xml version="1.0" ?>
<!--
  Simple indoor plumbing world for Companion ROBO Phases 1-4: floor, four
  walls, and a handful of primitive-shaped furniture pieces so Nav2 has
  something to avoid later. Not a polished environment.
-->
<sdf version="1.9">
  <world name="living_room">

    <physics name="1ms" type="ignored">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>

    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>
    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>
    <plugin filename="gz-sim-imu-system" name="gz::sim::systems::Imu"/>
    <plugin filename="gz-sim-contact-system" name="gz::sim::systems::Contact"/>

    <light type="directional" name="sun">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.8 0.8 0.8 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <attenuation>
        <range>1000</range>
        <constant>0.9</constant>
        <linear>0.01</linear>
        <quadratic>0.001</quadratic>
      </attenuation>
      <direction>-0.5 0.1 -0.9</direction>
    </light>

    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>10 8</size>
            </plane>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>10 8</size>
            </plane>
          </geometry>
          <material>
            <ambient>0.6 0.6 0.6 1</ambient>
            <diffuse>0.6 0.6 0.6 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- Room: 10m x 8m, walls 2.4m tall, 0.1m thick -->
    <model name="wall_north">
      <static>true</static>
      <pose>0 4 1.2 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>10 0.1 2.4</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>10 0.1 2.4</size></box></geometry>
          <material><ambient>0.85 0.83 0.78 1</ambient><diffuse>0.85 0.83 0.78 1</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="wall_south">
      <static>true</static>
      <pose>0 -4 1.2 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>10 0.1 2.4</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>10 0.1 2.4</size></box></geometry>
          <material><ambient>0.85 0.83 0.78 1</ambient><diffuse>0.85 0.83 0.78 1</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="wall_east">
      <static>true</static>
      <pose>5 0 1.2 0 0 1.5708</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>8 0.1 2.4</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>8 0.1 2.4</size></box></geometry>
          <material><ambient>0.85 0.83 0.78 1</ambient><diffuse>0.85 0.83 0.78 1</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="wall_west">
      <static>true</static>
      <pose>-5 0 1.2 0 0 1.5708</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>8 0.1 2.4</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>8 0.1 2.4</size></box></geometry>
          <material><ambient>0.85 0.83 0.78 1</ambient><diffuse>0.85 0.83 0.78 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- Furniture: coarse primitives, just obstacles for Nav2 to avoid later -->
    <model name="coffee_table">
      <static>true</static>
      <pose>1.0 0.5 0.2 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>0.9 0.5 0.4</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.9 0.5 0.4</size></box></geometry>
          <material><ambient>0.4 0.25 0.15 1</ambient><diffuse>0.4 0.25 0.15 1</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="sofa">
      <static>true</static>
      <pose>-2.5 2.8 0.4 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>2.0 0.9 0.8</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>2.0 0.9 0.8</size></box></geometry>
          <material><ambient>0.2 0.3 0.5 1</ambient><diffuse>0.2 0.3 0.5 1</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="bookshelf">
      <static>true</static>
      <pose>4.5 -3.0 0.9 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>0.35 1.2 1.8</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.35 1.2 1.8</size></box></geometry>
          <material><ambient>0.35 0.22 0.1 1</ambient><diffuse>0.35 0.22 0.1 1</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="dining_chair_1">
      <static>true</static>
      <pose>-3.5 -2.5 0.45 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><cylinder><radius>0.22</radius><length>0.9</length></cylinder></geometry>
        </collision>
        <visual name="visual">
          <geometry><cylinder><radius>0.22</radius><length>0.9</length></cylinder></geometry>
          <material><ambient>0.3 0.3 0.3 1</ambient><diffuse>0.3 0.3 0.3 1</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="dining_chair_2">
      <static>true</static>
      <pose>-2.7 -2.5 0.45 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><cylinder><radius>0.22</radius><length>0.9</length></cylinder></geometry>
        </collision>
        <visual name="visual">
          <geometry><cylinder><radius>0.22</radius><length>0.9</length></cylinder></geometry>
          <material><ambient>0.3 0.3 0.3 1</ambient><diffuse>0.3 0.3 0.3 1</diffuse></material>
        </visual>
      </link>
    </model>

  </world>
</sdf>
